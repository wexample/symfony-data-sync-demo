{
  "name": "wexample/symfony-data-sync-demo",
  "description": "Demo definitions showing every case of the symfony-data-sync-ds screens",
  "type": "library",
  "license": "MIT",
  "version": "2.0.7",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyDataSyncDemo\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyDataSyncDemo\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-data-sync": ">=3.1.0",
    "wexample/symfony-data-sync-ds": ">=2.0.0",
    "wexample/symfony-helpers": ">=18.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}